# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server configuration
PORT="3000"
CLIENT_ORIGIN="http://localhost:3000"

# Security & Authentication
# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET="your-super-secure-jwt-secret-key-change-in-production"

# Database Configuration
# MongoDB connection string (e.g. MongoDB Atlas or local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/secure_healthcare?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/secure_healthcare"
